# Copy to `.env` and fill in. Loaded automatically from the repo root when the dashboard starts.

# --- Taostats (required for the Taostats panel) ---
TAOSTATS_API_KEY=

# --- Taostats (optional) ---
# TAOSTATS_API_URL=https://api.taostats.io
# TAOSTATS_SNAPSHOT_PATH=
# TAOSTATS_MIN_DIVERGENCE_PCT=2
# TAOSTATS_LOOKBACK_SEC=86400
# TAOSTATS_LOOKBACK_TOLERANCE_SEC=7200
# TAOSTATS_REQUEST_TIMEOUT=60

# --- Hotkeys (optional) ---
# BITTENSOR_TOOLS_HOTKEYS=
# BITTENSOR_NETWORK=

# --- Dashboard process (optional; used by `python -m dashboard` only) ---
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765

# Comma-separated browser origins allowed to call the API (React dev server). Defaults include Vite on :5173.
# DASHBOARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
