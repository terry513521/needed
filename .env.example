# Copy to `.env` and fill in. Loaded automatically from the repo root when the dashboard starts.

# --- Taostats (required for the Taostats panel) ---
TAOSTATS_API_KEY=

# --- Taostats (optional) ---
# TAOSTATS_API_URL=https://api.taostats.io
# TAOSTATS_SNAPSHOT_PATH=
# TAOSTATS_MIN_DIVERGENCE_PCT=2
# TAOSTATS_LOOKBACK_SEC=86400
# TAOSTATS_LOOKBACK_TOLERANCE_SEC=7200
# TAOSTATS_REQUEST_TIMEOUT=60
# Blocks/day for τ/day = projected_emission (τ/block) × blocks (Finney ~12s → 7200)
# TAOSTATS_BLOCKS_PER_DAY=7200
# Subnet/latest page size (API max 1024). Pool/latest uses 200/page (API max).
# TAOSTATS_SUBNET_LATEST_LIMIT=1024
# Subnet emission: subnets per HTTP response (default 50, max 200); max paginated calls (default 5)
# TAOSTATS_SUBNET_EMISSION_LIMIT=50
# TAOSTATS_SUBNET_EMISSION_MAX_REQUESTS=5

# --- Hotkeys (optional) ---
# BITTENSOR_TOOLS_HOTKEYS=
# BITTENSOR_NETWORK=

# --- Dashboard process (optional; used by `python -m dashboard` only) ---
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765
# Logging: DEBUG shows Taostats pagination, urllib3; INFO default (HTTP access + summaries).
# Config runs at app startup (after uvicorn) so logs show in the terminal.
# DASHBOARD_LOG_LEVEL=INFO
# DASHBOARD_LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s

# Comma-separated browser origins allowed to call the API (React dev server). Defaults include Vite on :5173.
# DASHBOARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
